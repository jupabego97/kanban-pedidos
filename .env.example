DATABASE_PUBLIC_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# BD de catálogo. Productos: Tables/catalog_items (JSON con nombre y codigo_barras).
# Puede ser PostgreSQL (postgresql://...) o una API HTTP (https://...).
# Si es HTTP, se consulta {URL}/Tables/catalog_items
DATABASE_CATALOGO_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# CATALOGO_ITEMS_TABLE=catalog_items
# CATALOGO_API_KEY=

ALEGRA_API_URL=https://api.alegra.com/api/v1
ALEGRA_USER=tu_usuario_alegra
ALEGRA_TOKEN=tu_token_alegra
